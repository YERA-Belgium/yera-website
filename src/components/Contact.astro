---
import site from '@/data/site.json';import {buttonVariants} from './ui/button';
interface Props{locale?:'en'|'nl';}
const {locale='en'}=Astro.props;const copy=site.messages[locale];
---
<section class="page-intro"><div class="container"><span class="eyebrow">YERA · Leuven</span><h1>{copy.contact.title}</h1><p>{copy.contact.subtitle}</p></div></section><section class="section container contact-grid"><form id="contact-form" class="contact-form"><label for="name">{copy.contact.name}</label><input class="search-input" id="name" name="name" autocomplete="name" required maxlength="150"/><label for="email">E-mail</label><input class="search-input" type="email" id="email" name="email" autocomplete="email" required maxlength="254"/><label for="message">{copy.contact.message}</label><textarea id="message" name="message" required rows="7" maxlength="5000"></textarea><p>{locale==='nl'?'Dit opent een e-mailconcept in je mailprogramma. Verstuur het daar om ons te contacteren.':'This opens a draft in your email application. Send it there to contact us.'}</p><button class={buttonVariants()} type="submit">{locale==='nl'?'Open e-mailconcept':'Open email draft'}</button><noscript><p>JavaScript is needed to prepare the draft. Email <a href="mailto:info@yera.be">info@yera.be</a> directly.</p></noscript><p id="contact-status" role="status"></p></form><div><h2 style="font-size:2rem">info@yera.be</h2><p style="margin-block:20px">Leuven</p><a class="text-link" href="mailto:info@yera.be">{locale==='nl'?'Stuur een e-mail':'Send an email'}</a></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const subject=`YERA — ${data.get('name')}`;const body=`${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;window.location.href=`mailto:info@yera.be?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;const status=document.querySelector('#contact-status');if(status)status.textContent=document.documentElement.lang==='nl'?'E-mailconcept geopend. Als je mailprogramma niet opent, mail dan rechtstreeks naar info@yera.be.':'Email draft requested. If your email application did not open, email info@yera.be directly.';});
</script>
