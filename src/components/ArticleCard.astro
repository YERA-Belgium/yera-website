---
import {url} from '@/lib/utils';
import {responsiveImage} from '@/lib/images';
import {topicLabel,formatDate} from '@/lib/topics';
import type {Article} from '@/data/articles';
interface Props {article:Article;locale?:'en'|'nl';showSubtitle?:boolean;}
const {article,locale='en',showSubtitle=true}=Astro.props;
const image=article.image&&responsiveImage(article.image,600);
---
<article class="article-card">
{image&&<a class="cover-link" href={url(article.path)} tabindex="-1" aria-hidden="true"><img class="article-cover" src={image.src} srcset={image.srcset} sizes={image.sizes} alt={article.imageAlt} loading="lazy" decoding="async" width={image.width} height={image.height}/></a>}
<div class="article-card-body"><div class="article-meta"><span class="category">{topicLabel(article.title,locale)}</span><time datetime={article.date}>{formatDate(article.date,locale)}</time></div>
<h3><a href={url(article.path)}>{article.title}</a></h3>
{showSubtitle&&article.subtitle&&<p>{article.subtitle}</p>}<p class="social-post-authors">{locale==='nl'?'Door':'By'} {article.author}</p></div>
</article>