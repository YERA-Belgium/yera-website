---
import site from '@/data/site.json';import MemberGrid from './MemberGrid.astro';import {url} from '@/lib/utils';
interface Props{locale?:'en'|'nl';}const {locale='en'}=Astro.props;const copy=site.messages[locale];const current=site.boards.find(b=>b.current);
---
<section class="page-intro"><div class="container archive-intro about-page-intro"><div><span class="eyebrow">Young Energy Reviewers Association</span><h1>{copy.about.title}</h1></div><p>{locale==='nl'?'Een gedeelde nieuwsgierigheid naar de energiekeuzes die onze toekomst vormgeven.':'A shared curiosity about the energy choices shaping our future.'}</p></div></section><section class="section container about-intro"><div class="prose"><p set:html={copy.about.text}/></div></section>{current&&<section class="section board-section" id="board"><div class="container"><div class="section-heading"><div><span class="eyebrow">{current.title}</span><h2>{copy.about.boardOf}</h2></div><a class="text-link" href={url((locale==='nl'?'nl/':'')+'board/')}>{copy.navigation.formerBoards}</a></div><MemberGrid memberIds={current.memberIds}/></div></section>}
