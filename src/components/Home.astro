---
import site from '@/data/site.json';
import ArticleCard from './ArticleCard.astro';
import {url} from '@/lib/utils';
import {topics,topicFor,topicLabel,formatDate} from '@/lib/topics';
import {buttonVariants} from './ui/button';
interface Props {locale?:'en'|'nl';}
const {locale='en'}=Astro.props;const nl=locale==='nl';const copy=site.messages[locale];const prefix=nl?'nl/':'';
const nonEnglishSlugs=new Set(['het-eu-emissiehandelsysteem','kernuitstap-of-toch-niet','wereldwijde-cyberbeveiliging-in-de-energiesector-bewustwording-en-kwetsbaarheden']);
const seen=new Set<string>();const curated=site.articles.filter(a=>!nonEnglishSlugs.has(a.slug)).filter(a=>{const key=a.title.toLowerCase();if(seen.has(key))return false;seen.add(key);return true;});
const lead=curated[0];const recentPages=[curated.slice(1,4),curated.slice(4,7)].filter(page=>page.length>0);const current=site.boards.find(b=>b.current);
const faces=(current?.memberIds||[]).map(id=>site.members.find(m=>m.id===id)).filter(m=>m?.image).slice(0,5);
const parseEventDate=(date:string)=>{const [day,month,year]=date.split('/');return new Date(`${year}-${month}-${day}T23:59:59Z`);};
const upcomingEvent=site.events.filter(event=>parseEventDate(event.date)>new Date()).sort((a,b)=>parseEventDate(a.date).getTime()-parseEventDate(b.date).getTime())[0];
const [eventDay,,eventYear]=upcomingEvent.date.split('/');
const eventDate=parseEventDate(upcomingEvent.date);
const eventMonthText=new Intl.DateTimeFormat(nl?'nl-BE':'en-GB',{month:'short',timeZone:'UTC'}).format(eventDate);
interface SocialPost {slug:string;title:string;authors:string[];date:string;image:string;imageAlt:string;linkedinUrl:string;}
const postModules=import.meta.glob('../content/posts/*.json',{eager:true,import:'default'}) as Record<string,SocialPost>;
const latestPosts=Object.values(postModules).sort((a,b)=>(Date.parse(b.date)||0)-(Date.parse(a.date)||0));
const postPages=[latestPosts.slice(0,3),latestPosts.slice(3,6)].filter(page=>page.length>0);
---
<div class="container">
<section class="editorial-intro"><h1>{nl?'Energie in perspectief':'Energy in perspective'}</h1><p>{nl?'Onafhankelijke inzichten van een nieuwe generatie.':'Independent thinking from a new generation.'}</p></section>

<section class="lead-story" aria-labelledby="lead-title"><a class="lead-image" href={url(lead.path)} tabindex="-1" aria-hidden="true"><img src={url(lead.image)} alt={lead.imageAlt} width="900" height="670" fetchpriority="high"/></a><div class="lead-copy"><div class="story-kicker"><span class="eyebrow">{nl?'Uitgelicht':'In focus'}</span><span class="issue-line"></span></div><a class="topic-label" href={url(prefix+`articles/?topic=${topicFor(lead.title)}`)}>{topicLabel(lead.title,locale)}</a><h2 id="lead-title"><a href={url(lead.path)}>{lead.title}</a></h2><p class="lead-excerpt">{lead.description}…</p><div class="story-credit"><span>{lead.author}</span><time datetime={lead.date}>{formatDate(lead.date,locale)}</time></div><a class="text-link" href={url(lead.path)}>{nl?'Lees het artikel':'Read the story'}</a></div></section>

<section class="section upcoming-event" aria-labelledby="upcoming-event-title"><div class="section-heading"><div><h2 class="cursive-heading" id="upcoming-event-title">{nl?'Save the Date':'Save the Date'}</h2></div><a class="text-link" href={url(prefix+'events/')}>{copy.event.showAll}</a></div><div class="lead-story event-feature"><div class="lead-copy event-feature-copy"><h3><a href={url(upcomingEvent.path)}>{upcomingEvent.title}</a></h3><div class="event-meta"><div class="event-date"><span>{eventMonthText} {eventYear}</span><strong>{eventDay}</strong></div><div class="event-details"><p class="event-time">{upcomingEvent.start} – {upcomingEvent.end}</p><p class="event-location">{upcomingEvent.location}</p></div></div><a class="text-link" href={url(upcomingEvent.path)}>{nl?'Bekijk evenement':'View event'}</a></div><a class="lead-image event-feature-image" href={url(upcomingEvent.path)} tabindex="-1" aria-hidden="true"><img src={url(upcomingEvent.image)} alt={upcomingEvent.title} loading="lazy"/></a></div></section>

<section class="section latest-posts-section" aria-labelledby="latest-posts-title"><div class="section-heading"><div class="latest-insights-heading"><h2 class="cursive-heading" id="latest-posts-title">{nl?'Laatste inzichten':'Latest Insights'}</h2></div><div class="latest-articles-controls">{postPages.length>1&&<><button class="article-page-button" type="button" data-post-page-direction="-1" aria-label={nl?'Vorige inzichten':'Previous insights'} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="article-page-button" type="button" data-post-page-direction="1" aria-label={nl?'Volgende inzichten':'Next insights'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></>}<div class="social-buttons"><a class="social-button" href="https://www.linkedin.com/company/yera-young-energy-reviewers-association/" target="_blank" rel="noreferrer">LinkedIn</a><span aria-hidden="true">|</span><a class="social-button" href="https://www.instagram.com/yera_belgium/" target="_blank" rel="noreferrer">Instagram</a><span aria-hidden="true">|</span><a class="social-button" href="https://www.facebook.com/YeraBelgium" target="_blank" rel="noreferrer">Facebook</a></div></div></div><div class="latest-post-pages">{postPages.map((page,index)=><div class="social-post-grid" data-post-page={index} aria-hidden={index!==0} hidden={index!==0}>{page.map(post=><article class="social-post-card"><a class="social-post-link" href={post.linkedinUrl||undefined} target={post.linkedinUrl?'_blank':undefined} rel={post.linkedinUrl?'noreferrer':undefined} aria-label={post.linkedinUrl?`Read ${post.title} on LinkedIn`:post.title}><img src={url(post.image)} alt={post.imageAlt} width="768" height="768" loading="lazy"/></a><h3>{post.linkedinUrl?<a href={post.linkedinUrl} target="_blank" rel="noreferrer">{post.title}</a>:post.title}</h3>{post.authors.length>0&&<p class="social-post-authors">{nl?'Door':'By'} {post.authors.join(', ')}</p>}{post.date&&<time datetime={post.date}>{post.date}</time>}</article>)}</div>)}</div></section>

<section class="topic-section"><div><span class="eyebrow">{nl?'Volg je nieuwsgierigheid':'Follow your interests'}</span><h2>{nl?'Waar begint jouw vraag?':'Where does your curiosity lead?'}</h2></div><nav class="topic-index" aria-label={nl?'Onderwerpen':'Browse topics'}>{topics.map(topic=><a href={url(prefix+`articles/?topic=${topic.id}`)}><span class="topic-icon" aria-hidden="true">
{topic.id==='grids'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M13.5 2.5 5 13h5l-.5 8.5L19 10h-5l-.5-7.5Z"/></svg>}
{topic.id==='renewables'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M20 4C11 4 5 7 5 13a6 6 0 0 0 6 6c6 0 9-6 9-15Z"/><path d="M4 21c3-5 7-8 12-11"/></svg>}
{topic.id==='nuclear'&&<svg viewBox="0 0 24 24" focusable="false"><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(30 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(-30 12 12)"/><circle cx="12" cy="12" r="1"/></svg>}
{topic.id==='storage'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M5 16h14l1-5-2-2-1.5-4h-9L6 9l-2 2 1 5Z"/><path d="M10 10h4m-3 2-1 2h3l-1 2"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/></svg>}
{topic.id==='markets'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M4 20V5m0 15h17M7 15l4-4 3 2 6-7"/><path d="M16 6h4v4"/></svg>}
{topic.id==='climate'&&<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>}
</span><span>{topic[locale]}</span><span class="topic-count">{site.articles.filter(a=>topicFor(a.title)===topic.id).length}</span></a>)}</nav></section>

<section class="section latest-section" aria-label={nl?'Meer artikels':'More articles'}><div class="section-heading"><div><h2 class="cursive-heading">{nl?'Energie van dichterbij':'A closer look at energy'}</h2></div><div class="latest-articles-controls">{recentPages.length>1&&<><button class="article-page-button" type="button" data-article-page-direction="-1" aria-label={nl?'Vorige artikels':'Previous articles'} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="article-page-button" type="button" data-article-page-direction="1" aria-label={nl?'Volgende artikels':'Next articles'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></>}<a class="text-link" href={url(prefix+'articles/')}>{nl?'Alle artikels':'All articles'}</a></div></div><div class="latest-article-pages">{recentPages.map((page,index)=><div class="article-grid" data-article-page={index} aria-hidden={index!==0} hidden={index!==0}>{page.map(article=><ArticleCard article={article} locale={locale}/>)}</div>)}</div></section>

</div>
<section class="community-band" id="about"><div class="container community-grid"><div><span class="eyebrow">Young Energy Reviewers Association</span><h2>{nl?'Jonge denkers \nGrote vraagstukken':'Young minds \nBig energy questions'}</h2><div class="community-portraits">{faces.map(member=><img src={url(member!.image)} alt={member!.name} width="62" height="62" loading="lazy"/>)}</div><a class="light-link" href={url(prefix+'about/')}>{nl?'Ontmoet YERA':'Meet YERA'}</a></div><div><p set:html={copy.about.text}/><div class="community-note" id="board"><span>{current?.title}</span><a href={url(prefix+'about/#board')}>{copy.about.boardOf}</a></div></div></div></section>

<section class="contribute-section container" id="contact"><span class="eyebrow">{nl?'Jouw perspectief telt':'Bring your perspective'}</span><div><h2>{nl?'Een vraag, een idee, \nEen andere kijk?':'A question, an idea,\nA different view?'}</h2><div><p>{nl?'Schrijf mee, stel je vragen of help ons mensen samen te brengen.':'Write with us, ask a question, or help bring people together.'}</p><a class={buttonVariants({size:'lg'})} href={url(prefix+'contact/')}>{nl?'Neem contact op':'Get in touch'}</a></div></div></section>

<script>
 const articleSection=document.querySelector<HTMLElement>('.latest-section');
 const articlePages=articleSection?.querySelectorAll<HTMLElement>('[data-article-page]');
 const pageButtons=articleSection?.querySelectorAll<HTMLButtonElement>('[data-article-page-direction]');
 let currentPage=0;
 pageButtons?.forEach(button=>button.addEventListener('click',()=>{
  if(!articlePages?.length)return;
  currentPage=Math.max(0,Math.min(articlePages.length-1,currentPage+Number(button.dataset.articlePageDirection)));
  articlePages.forEach((page,index)=>{
   const active=index===currentPage;
   page.classList.remove('article-page-enter');
   page.hidden=!active;
   page.setAttribute('aria-hidden',String(!active));
   if(active)requestAnimationFrame(()=>page.classList.add('article-page-enter'));
  });
  pageButtons.forEach(item=>{item.disabled=(currentPage===0&&item.dataset.articlePageDirection==='-1')||(currentPage===articlePages.length-1&&item.dataset.articlePageDirection==='1');});
 }));
 const postSection=document.querySelector<HTMLElement>('.latest-posts-section');
 const postPagesElements=postSection?.querySelectorAll<HTMLElement>('[data-post-page]');
 const postButtons=postSection?.querySelectorAll<HTMLButtonElement>('[data-post-page-direction]');
 let currentPostPage=0;
 postButtons?.forEach(button=>button.addEventListener('click',()=>{
  if(!postPagesElements?.length)return;
  currentPostPage=Math.max(0,Math.min(postPagesElements.length-1,currentPostPage+Number(button.dataset.postPageDirection)));
  postPagesElements.forEach((page,index)=>{
   const active=index===currentPostPage;
   page.classList.remove('article-page-enter');
   page.hidden=!active;
   page.setAttribute('aria-hidden',String(!active));
   if(active)requestAnimationFrame(()=>page.classList.add('article-page-enter'));
  });
  postButtons.forEach(item=>{item.disabled=(currentPostPage===0&&item.dataset.postPageDirection==='-1')||(currentPostPage===postPagesElements.length-1&&item.dataset.postPageDirection==='1');});
 }));
  const revealTargets=document.querySelectorAll<HTMLElement>('main > .container > section, main > section');
  const revealItems=document.querySelectorAll<HTMLElement>('.social-post-card, .article-card, .topic-index a');
  const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduceMotion){
   document.documentElement.classList.add('has-scroll-reveal');
   revealTargets.forEach(target=>target.dataset.reveal='');
   revealItems.forEach((item,index)=>{
    item.dataset.reveal='';
    item.style.setProperty('--reveal-delay',`${(index%3)*70}ms`);
   });
   const revealObserver=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
     if(entry.isIntersecting){
      entry.target.classList.add('is-revealed');
      revealObserver.unobserve(entry.target);
     }
    });
   },{threshold:.12,rootMargin:'0px 0px -36px'});
   document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(target=>revealObserver.observe(target));
  }
</script>
