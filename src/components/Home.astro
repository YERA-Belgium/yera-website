 const setupEventSlider=()=>{
  const slider=document.querySelector<HTMLElement>('[data-event-slider]');
  const pages=slider?Array.from(slider.querySelectorAll<HTMLElement>('[data-event-page]')):[];
  if(!slider||pages.length<2)return;
  const prev=slider.querySelector<HTMLButtonElement>('[data-event-prev]');
  const next=slider.querySelector<HTMLButtonElement>('[data-event-next]');
  const pauseButton=slider.querySelector<HTMLButtonElement>('[data-event-slider-pause]');
  const segmentList=slider.querySelector<HTMLElement>('[data-event-slider-segments]');
  const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
  let current=0;
  let timer:number|undefined;
  let transitionTimer:number|undefined;
  let paused=false;
  let stickyPaused=reducedMotion.matches;
  let segments:HTMLButtonElement[]=[];
  const restartProgress=()=>{
   segments.forEach((segment,index)=>{
    segment.classList.remove('is-running');
    segment.classList.toggle('is-active',index===current);
    if(index===current)segment.setAttribute('aria-current','true');else segment.removeAttribute('aria-current');
   });
   const segment=segments[current];
   if(!segment)return;
   void segment.offsetWidth;
   segment.classList.add('is-running');
  };
  const stopTimer=()=>{if(timer!==undefined){window.clearInterval(timer);timer=undefined;}};
  const updatePauseState=()=>{
   slider.classList.toggle('slider-paused',paused||stickyPaused||document.hidden);
   if(pauseButton){
    pauseButton.dataset.state=stickyPaused?'paused':'playing';
    pauseButton.setAttribute('aria-label',(stickyPaused?pauseButton.dataset.labelPlay:pauseButton.dataset.labelPause)||'');
   }
  };
  const startTimer=()=>{
   stopTimer();
   updatePauseState();
   restartProgress();
  };
  const updateArrows=()=>{
   if(prev){
    const usable=current>0;
    prev.classList.toggle('is-hidden',!usable);
    prev.tabIndex=usable?0:-1;
   }
   if(next){
    const usable=current<pages.length-1;
    next.classList.toggle('is-hidden',!usable);
    next.tabIndex=usable?0:-1;
   }
  };
  const placeArrows=()=>{
   const container=slider.querySelector<HTMLElement>('.event-feature-pages');
   const page=pages[current];
   if(!container||!page)return;
   const image=page.querySelector<HTMLImageElement>('.event-feature-image img');
   const feature=image?.offsetHeight?image:page.querySelector<HTMLElement>('.event-feature');
   if(!feature)return;
   const containerRect=container.getBoundingClientRect();
   const featureRect=feature.getBoundingClientRect();
   const top=featureRect.top-containerRect.top+featureRect.height/2;
   container.style.setProperty('--slider-arrow-top',`${Math.round(top)}px`);
  };
  const show=(index:number)=>{
   const target=(index+pages.length)%pages.length;
   if(target===current)return;
   const outgoing=pages[current];
   const incoming=pages[target];
   const direction=index>current?'next':'previous';
   const container=slider.querySelector<HTMLElement>('.event-feature-pages');

   if(transitionTimer!==undefined)window.clearTimeout(transitionTimer);
   if(container)container.style.height=`${outgoing.offsetHeight}px`;
   pages.forEach(page=>{
    page.getAnimations().forEach(animation=>animation.cancel());
    if(page!==outgoing&&page!==incoming){
     page.hidden=true;
     page.setAttribute('aria-hidden','true');
    }
   });

   current=target;
   updateArrows();
   restartProgress();

   if(!reducedMotion.matches&&outgoing.animate&&incoming.animate){
    const incomingOffset=direction==='next'?24:-24;
    const outgoingAnimation=outgoing.animate([
     {opacity:1,transform:'translateX(0)'},
     {opacity:0,transform:'translateX(0)',offset:1}
    ],{duration:240,easing:'ease-in',fill:'both'});

    outgoingAnimation.finished.then(()=>{
     outgoing.hidden=true;
     outgoing.setAttribute('aria-hidden','true');
     incoming.hidden=false;
     incoming.setAttribute('aria-hidden','false');
     incoming.animate([
      {opacity:0,transform:`translateX(${incomingOffset}px)`},
      {opacity:1,transform:'translateX(0)'}
     ],{duration:420,easing:'cubic-bezier(.2,.8,.2,1)',fill:'both'});

     placeArrows();
     transitionTimer=window.setTimeout(()=>{
      incoming.getAnimations().forEach(animation=>animation.cancel());
      if(container)container.style.removeProperty('height');
      placeArrows();
      transitionTimer=undefined;
     },420);
    }).catch(()=>{});
   }else{
    outgoing.hidden=true;
    outgoing.setAttribute('aria-hidden','true');
    incoming.hidden=false;
    incoming.setAttribute('aria-hidden','false');
    if(container)container.style.removeProperty('height');
    placeArrows();
   }
  };
  segments=Array.from(pages,(_,index)=>{
   const segment=document.createElement('button');
   segment.type='button';
   segment.className='slider-segment';
   segment.setAttribute('aria-label',(segmentList?.dataset.labelEvent||'Go to event {n}').replace('{n}',String(index+1)));
   const fill=document.createElement('span');
   fill.className='slider-segment-fill';
   fill.addEventListener('animationend',()=>{if(segment.classList.contains('is-running')){show((current+1)%pages.length);startTimer();}});
   segment.append(fill);
   segment.addEventListener('click',()=>{show(index);startTimer();});
   return segment;
  });
  segmentList?.replaceChildren(...segments);
  pauseButton?.addEventListener('click',()=>{
   stickyPaused=!stickyPaused;
   if(stickyPaused)stopTimer();else startTimer();
   updatePauseState();
  });
  prev?.addEventListener('click',()=>{show(current-1);startTimer();});
  next?.addEventListener('click',()=>{show(current+1);startTimer();});
  slider.addEventListener('pointerenter',event=>{
   if(event.pointerType==='mouse'){paused=true;updatePauseState();}
  });
  slider.addEventListener('pointerleave',event=>{
   if(event.pointerType==='mouse'){paused=false;updatePauseState();}
  });
  let touchStartX=0;
  let touchStartY=0;
  let swiping=false;
  const container=slider.querySelector<HTMLElement>('.event-feature-pages');
  container?.addEventListener('touchstart',event=>{
   const touch=event.changedTouches[0];
   touchStartX=touch.clientX;
   touchStartY=touch.clientY;
   swiping=true;
   paused=true;
   updatePauseState();
  },{passive:true});
  container?.addEventListener('touchend',event=>{
   if(!swiping)return;
   swiping=false;
   const touch=event.changedTouches[0];
   const deltaX=touch.clientX-touchStartX;
   const deltaY=touch.clientY-touchStartY;
   paused=false;
   if(Math.abs(deltaX)>55&&Math.abs(deltaX)>Math.abs(deltaY)*1.25){
    show(deltaX<0?current+1:current-1);
   }
   startTimer();
  },{passive:true});
  container?.addEventListener('touchcancel',()=>{
   swiping=false;
   paused=false;
   startTimer();
  },{passive:true});
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stopTimer();else startTimer();});
  reducedMotion.addEventListener('change',event=>{stickyPaused=event.matches;startTimer();});
  pages.forEach(page=>page.querySelectorAll('img').forEach(image=>image.addEventListener('load',placeArrows,{once:true})));
  window.addEventListener('resize',placeArrows);
  updateArrows();
  placeArrows();
  startTimer();
 };
 setupEventSlider();
  const revealTargets=[...document.querySelectorAll<HTMLElement>('main > .container > section:not(.topic-section), main > section:not(.topic-section)')].filter(target=>!target.querySelector('.social-post-card, .article-card'));
  const revealItems=document.querySelectorAll<HTMLElement>('.social-post-card, .article-card');
  const topicItems=document.querySelectorAll<HTMLElement>('.topic-index a');
  const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const startScrollReveal=()=>{
   document.documentElement.classList.add('has-scroll-reveal');
   const isAboveFold=(target:HTMLElement)=>target.getClientRects().length>0&&target.getBoundingClientRect().top<window.innerHeight;
   revealTargets.forEach(target=>{
    if(!isAboveFold(target))target.dataset.reveal='';
   });
   revealItems.forEach((item,index)=>{
    if(!isAboveFold(item)){
     item.dataset.reveal='';
     item.style.setProperty('--reveal-delay',`${(index%3)*70}ms`);
    }
   });
   topicItems.forEach((item,index)=>{
    if(!isAboveFold(item)){
     item.dataset.reveal='';
     item.style.setProperty('--reveal-delay',`${index*70}ms`);
    }
   });
   const revealObserver=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
     if(entry.isIntersecting){
      entry.target.classList.add('is-revealed');
      revealObserver.unobserve(entry.target);
     }
    });
   },{threshold:.12,rootMargin:'0px 0px -36px'});
   document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(target=>revealObserver.observe(target));
  };
  const pageContent=document.querySelector<HTMLElement>('.page-content-enter');
  if(reduceMotion||!pageContent){
   startScrollReveal();
  }else{
   pageContent.addEventListener('animationend',startScrollReveal,{once:true});
  }
</script>
