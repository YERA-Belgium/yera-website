---
import site from '@/data/site.json';
import ArticleCard from './ArticleCard.astro';
import {url} from '@/lib/utils';
import {topics,topicFor,topicLabel,formatDate} from '@/lib/topics';
import {buttonVariants} from './ui/button';
interface Props {locale?:'en'|'nl';}
const {locale='en'}=Astro.props;const nl=locale==='nl';const copy=site.messages[locale];const prefix=nl?'nl/':'';
const seen=new Set<string>();const curated=site.articles.filter(a=>{const key=a.title.toLowerCase();if(seen.has(key))return false;seen.add(key);return true;});
const lead=curated[0];const recent=curated.slice(1,4);const current=site.boards.find(b=>b.current);
const faces=(current?.memberIds||[]).map(id=>site.members.find(m=>m.id===id)).filter(m=>m?.image).slice(0,5);
const parseEventDate=(date:string)=>{const [day,month,year]=date.split('/');return new Date(`${year}-${month}-${day}T23:59:59Z`);};
const upcomingEvent=site.events.filter(event=>parseEventDate(event.date)>new Date()).sort((a,b)=>parseEventDate(a.date).getTime()-parseEventDate(b.date).getTime())[0];
const [eventDay,,eventYear]=upcomingEvent.date.split('/');
const eventDate=parseEventDate(upcomingEvent.date);
const eventMonthText=new Intl.DateTimeFormat(nl?'nl-BE':'en-GB',{month:'short',timeZone:'UTC'}).format(eventDate);
interface SocialPost {slug:string;title:string;authors:string[];date:string;image:string;imageAlt:string;linkedinUrl:string;}
const postModules=import.meta.glob('../content/posts/*.json',{eager:true,import:'default'}) as Record<string,SocialPost>;
const latestPosts=Object.values(postModules).sort((a,b)=>(Date.parse(b.date)||0)-(Date.parse(a.date)||0)).slice(0,3);
---
<div class="container">
<section class="editorial-intro"><h1>{nl?'Energie in perspectief':'Energy in perspective'}</h1><p>{nl?'Onafhankelijke inzichten van een nieuwe generatie.':'Independent thinking from a new generation.'}</p></section>

<section class="lead-story" aria-labelledby="lead-title"><a class="lead-image" href={url(lead.path)} tabindex="-1" aria-hidden="true"><img src={url(lead.image)} alt={lead.imageAlt} width="900" height="670" fetchpriority="high"/></a><div class="lead-copy"><div class="story-kicker"><span class="eyebrow">{nl?'Uitgelicht':'In focus'}</span><span class="issue-line"></span></div><a class="topic-label" href={url(prefix+`articles/?topic=${topicFor(lead.title)}`)}>{topicLabel(lead.title,locale)}</a><h2 id="lead-title"><a href={url(lead.path)}>{lead.title}</a></h2><p class="lead-excerpt">{lead.description}…</p><div class="story-credit"><span>{lead.author}</span><time datetime={lead.date}>{formatDate(lead.date,locale)}</time></div><a class="text-link" href={url(lead.path)}>{nl?'Lees het artikel':'Read the story'}</a></div></section>

<section class="section upcoming-event" aria-labelledby="upcoming-event-title"><div class="section-heading"><div><h2 class="cursive-heading" id="upcoming-event-title">{nl?'Save the Date':'Save the Date'}</h2></div><a class="text-link" href={url(prefix+'events/')}>{copy.event.showAll}</a></div><div class="lead-story event-feature"><div class="lead-copy event-feature-copy"><h3><a href={url(upcomingEvent.path)}>{upcomingEvent.title}</a></h3><div class="event-meta"><div class="event-date"><span>{eventMonthText} {eventYear}</span><strong>{eventDay}</strong></div><div class="event-details"><p class="event-time">{upcomingEvent.start} – {upcomingEvent.end}</p><p class="event-location">{upcomingEvent.location}</p></div></div><a class="text-link" href={url(upcomingEvent.path)}>{nl?'Bekijk evenement':'View event'}</a></div><a class="lead-image event-feature-image" href={url(upcomingEvent.path)} tabindex="-1" aria-hidden="true"><img src={url(upcomingEvent.image)} alt={upcomingEvent.title} width="900" height="670" loading="lazy"/></a></div></section>

<section class="section latest-posts-section" aria-labelledby="latest-posts-title"><div class="section-heading"><div><h2 class="cursive-heading" id="latest-posts-title">{nl?'Laatste inzichten':'Latest Insights'}</h2></div></div><div class="social-post-grid">{latestPosts.map(post=><article class="social-post-card"><a class="social-post-link" href={post.linkedinUrl||undefined} target={post.linkedinUrl?'_blank':undefined} rel={post.linkedinUrl?'noreferrer':undefined} aria-label={post.linkedinUrl?`Read ${post.title} on LinkedIn`:post.title}><img src={url(post.image)} alt={post.imageAlt} width="768" height="768" loading="lazy"/></a><h3>{post.title}</h3>{post.authors.length>0&&<p class="social-post-authors">{nl?'Door':'By'} {post.authors.join(', ')}</p>}{post.date&&<time datetime={post.date}>{post.date}</time>}</article>)}</div></section>

<section class="topic-section"><div><span class="eyebrow">{nl?'Volg je nieuwsgierigheid':'Follow your curiosity'}</span><h2>{nl?'Waar begint jouw vraag?':'Where does your curiosity lead?'}</h2></div><nav class="topic-index" aria-label={nl?'Onderwerpen':'Browse topics'}>{topics.map((topic,i)=><a href={url(prefix+`articles/?topic=${topic.id}`)}><span class="topic-number">0{i+1}</span><span>{topic[locale]}</span><span class="topic-count">{site.articles.filter(a=>topicFor(a.title)===topic.id).length}</span></a>)}</nav></section>

<section class="section latest-section"><div class="section-heading"><div><h2 class="cursive-heading">{nl?'Verder kijken, Beter begrijpen':'A closer look at energy'}</h2></div><a class="text-link" href={url(prefix+'articles/')}>{nl?'Alle artikels':'All articles'}</a></div><div class="article-grid">{recent.map(article=><ArticleCard article={article} locale={locale}/>)}</div></section>

</div>
<section class="community-band" id="about"><div class="container community-grid"><div><span class="eyebrow">Young Energy Reviewers Association</span><h2>{nl?'Jonge denkers \nGrote vraagstukken':'Young minds \nBig energy questions'}</h2><div class="community-portraits">{faces.map(member=><img src={url(member!.image)} alt={member!.name} width="62" height="62" loading="lazy"/>)}</div><a class="light-link" href={url(prefix+'about/')}>{nl?'Ontmoet YERA':'Meet YERA'}</a></div><div><p set:html={copy.about.text}/><div class="community-note" id="board"><span>{current?.title}</span><a href={url(prefix+'about/#board')}>{copy.about.boardOf}</a></div></div></div></section>

<section class="contribute-section container" id="contact"><span class="eyebrow">{nl?'Jouw perspectief telt':'Bring your perspective'}</span><div><h2>{nl?'Een vraag, Een idee, \nEen nieuw perspectief':'A question, An idea,\nA different perspective'}</h2><div><p>{nl?'Schrijf mee, stel je vragen of help ons mensen samen te brengen.':'Write with us, ask a question, or help bring people together.'}</p><a class={buttonVariants({size:'lg'})} href={url(prefix+'contact/')}>{nl?'Neem contact op':'Get in touch'}</a></div></div></section>
