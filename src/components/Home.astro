---
import site from '@/data/site.json';
import ArticleCard from './ArticleCard.astro';
import {url} from '@/lib/utils';
import {responsiveImage,imageSizes,imageAspect,closeCropScale} from '@/lib/images';
import {topics,topicFor,topicLabel,formatDate} from '@/lib/topics';
import {eventDate,isPastEvent} from '@/lib/events';
import {buttonVariants} from './ui/button';
interface Props {locale?:'en'|'nl';}
const {locale='en'}=Astro.props;const nl=locale==='nl';const copy=site.messages[locale];const prefix=nl?'nl/':'';
const nonEnglishSlugs=new Set(['het-eu-emissiehandelsysteem','kernuitstap-of-toch-niet','wereldwijde-cyberbeveiliging-in-de-energiesector-bewustwording-en-kwetsbaarheden']);
const homepageDescriptionlessSlugs=new Set(['electric-vessels-the-next-tech-of-energy-storage','global-cybersecurity-in-the-energy-sector-awareness-and-vulnerabilities']);
const seen=new Set<string>();const curated=site.articles.filter(a=>!nonEnglishSlugs.has(a.slug)).filter(a=>{const key=a.title.toLowerCase();if(seen.has(key))return false;seen.add(key);return true;});
const lead=curated[0];const recentPages=[curated.slice(1,4),curated.slice(4,7)].filter(page=>page.length>0);const current=site.boards.find(b=>b.current);
const faces=(current?.memberIds||[]).map(id=>site.members.find(m=>m.id===id)).filter(m=>m?.image).slice(0,5);
const upcomingEvents=site.events.filter(event=>!isPastEvent(event.date)).sort((a,b)=>eventDate(a.date).getTime()-eventDate(b.date).getTime());
interface SocialPost {slug:string;title:string;authors:string[];date:string;image:string;imageAlt:string;linkedinUrl:string;}
const postModules=import.meta.glob('../content/posts/*.json',{eager:true,import:'default'}) as Record<string,SocialPost>;
const latestPosts=Object.values(postModules).sort((a,b)=>(Date.parse(b.date)||0)-(Date.parse(a.date)||0));
const postPages=[latestPosts.slice(0,3),latestPosts.slice(3,6)].filter(page=>page.length>0);
const leadImage=responsiveImage(lead.image,imageSizes.lead(imageAspect(lead.image)));
const upcomingImages=new Map(upcomingEvents.map(event=>[event,event.image?responsiveImage(event.image,imageSizes.eventFeature(imageAspect(event.image))):undefined]));
const postImages=new Map(latestPosts.map(post=>[post,responsiveImage(post.image,imageSizes.carouselCard)]));
const faceImages=new Map(faces.map(member=>[member,responsiveImage(member!.image,imageSizes.portrait(closeCropScale(member!.portraitCrop)))]));
---
<div class="container">
<section class="editorial-intro"><h1>{nl?'Energie in perspectief':'Energy in perspective'}</h1><p>{nl?'Onafhankelijke inzichten van een nieuwe generatie.':'Independent thinking from a new generation.'}</p></section>

<section class="lead-story" aria-labelledby="lead-title"><a class="lead-image" href={url(lead.path)} tabindex="-1" aria-hidden="true"><img src={leadImage.src} srcset={leadImage.srcset} sizes={leadImage.sizes} alt={lead.imageAlt} width={leadImage.width} height={leadImage.height} fetchpriority="high"/></a><div class="lead-copy"><div class="story-kicker"><span class="eyebrow">{nl?'Uitgelicht':'In focus'}</span><span class="issue-line"></span></div><a class="topic-label" href={url(prefix+`articles/?topic=${topicFor(lead.title)}`)}>{topicLabel(lead.title,locale)}</a><h2 id="lead-title"><a href={url(lead.path)}>{lead.title}</a></h2><p class="lead-excerpt">{lead.description}…</p><div class="story-credit"><span>{lead.author}</span><time datetime={lead.date}>{formatDate(lead.date,locale)}</time></div><a class="text-link" href={url(lead.path)}>{nl?'Lees het artikel':'Read the story'}</a></div></section>

{upcomingEvents.length>0&&<section class="section upcoming-event" aria-labelledby="upcoming-event-title" data-event-slider>
<div class="section-heading"><div><h2 class="cursive-heading" id="upcoming-event-title">{nl?'Save the Date':'Save the Date'}</h2></div><div class="latest-articles-controls">{upcomingEvents.length>1&&<div class="slider-controls" data-event-slider-controls><button class="slider-pause" type="button" data-event-slider-pause data-state="playing" aria-label={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-pause={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-play={nl?'Hervat automatisch doorschuiven':'Resume autoplay'}><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4a.6.6 0 0 0 .9.5l9.8-6.2a.6.6 0 0 0 0-1L9.4 5.3a.6.6 0 0 0-.9.5Z"/></svg></button><div class="slider-segments" data-event-slider-segments role="group" aria-label={nl?'Kies welk evenement je ziet':'Choose which event to show'} data-label-event={nl?'Ga naar evenement {n}':'Go to event {n}'}></div></div>}<a class="text-link" href={url(prefix+'events/')}>{copy.event.showAll}</a></div></div>
<div class="event-feature-pages">
 {upcomingEvents.length>1&&<><button class="slider-arrow slider-arrow--prev is-hidden" type="button" data-event-prev aria-label={nl?'Vorige evenement':'Previous event'} tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="slider-arrow slider-arrow--next" type="button" data-event-next aria-label={nl?'Volgende evenement':'Next event'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></>}
 {upcomingEvents.map((event,index)=>{
  const [day,,year]=event.date.split('/');
  const month=new Intl.DateTimeFormat(nl?'nl-BE':'en-GB',{month:'short',timeZone:'UTC'}).format(eventDate(event.date));
  const image=upcomingImages.get(event);
  return <div class="event-feature-page" data-event-page={index} aria-hidden={index!==0} hidden={index!==0}>
   <div class="lead-story event-feature">
    <div class="lead-copy event-feature-copy">
     <h3><a href={url(event.path)}>{event.title}</a></h3>
     <div class="event-meta"><div class="event-date"><span>{month} {year}</span><strong>{day}</strong></div><div class="event-details"><p class="event-time">{event.start} – {event.end}</p><p class="event-location">{event.location}</p></div></div>
     <a class="text-link" href={url(event.path)}>{nl?'Bekijk evenement':'View event'}</a>
    </div>
    {image&&<a class="lead-image event-feature-image" href={url(event.path)} tabindex="-1" aria-hidden="true"><img src={image.src} srcset={image.srcset} sizes={image.sizes} alt={event.title} width={image.width} height={image.height} loading={index===0?'eager':'lazy'} decoding="async"/></a>}
   </div>
  </div>;
 })}
</div>
</section>}

<section class="section latest-posts-section" aria-labelledby="latest-posts-title"><div class="section-heading"><div class="latest-insights-heading"><h2 class="cursive-heading" id="latest-posts-title">{nl?'Laatste inzichten':'Latest Insights'}</h2></div><div class="latest-articles-controls">{postPages.length>1&&<div class="slider-controls" data-slider-controls hidden><button class="slider-pause" type="button" data-slider-pause data-state="playing" aria-label={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-pause={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-play={nl?'Hervat automatisch doorschuiven':'Resume autoplay'}><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4a.6.6 0 0 0 .9.5l9.8-6.2a.6.6 0 0 0 0-1L9.4 5.3a.6.6 0 0 0-.9.5Z"/></svg></button><div class="slider-segments" data-slider-segments role="group" aria-label={nl?'Kies wat je ziet':'Choose what to show'} data-label-page={nl?'Ga naar pagina {n}':'Go to page {n}'} data-label-card={nl?'Ga naar kaart {n}':'Go to card {n}'}></div></div>}<div class="social-buttons"><a class="social-button" href="https://www.linkedin.com/company/yera-young-energy-reviewers-association/" target="_blank" rel="noreferrer">LinkedIn</a><span aria-hidden="true">|</span><a class="social-button" href="https://www.instagram.com/yera_belgium/" target="_blank" rel="noreferrer">Instagram</a><span aria-hidden="true">|</span><a class="social-button" href="https://www.facebook.com/YeraBelgium" target="_blank" rel="noreferrer">Facebook</a></div></div></div><div class="latest-post-pages">{postPages.length>1&&<><button class="slider-arrow slider-arrow--prev is-hidden" type="button" data-slider-prev aria-label={nl?'Vorige inzichten':'Previous insights'} tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="slider-arrow slider-arrow--next" type="button" data-slider-next aria-label={nl?'Volgende inzichten':'Next insights'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></>}{postPages.map((page,index)=><div class="social-post-grid" data-post-page={index} aria-hidden={index!==0} hidden={index!==0}>{page.map(post=><article class="social-post-card"><a class="social-post-link" href={post.linkedinUrl||undefined} target={post.linkedinUrl?'_blank':undefined} rel={post.linkedinUrl?'noreferrer':undefined} aria-label={post.linkedinUrl?`Read ${post.title} on LinkedIn`:post.title}><img {...postImages.get(post)} alt={post.imageAlt} loading="lazy" decoding="async"/></a><div class="social-post-card-body">{post.date&&<div class="social-post-meta"><time datetime={post.date}>{formatDate(post.date,locale)}</time></div>}<h3>{post.linkedinUrl?<a href={post.linkedinUrl} target="_blank" rel="noreferrer">{post.title}</a>:post.title}</h3>{post.authors.length>0&&<p class="social-post-authors">{nl?'Door':'By'} {post.authors.join(', ')}</p>}</div></article>)}</div>)}</div></section>

<section class="topic-section"><div><span class="eyebrow">{nl?'Volg je nieuwsgierigheid':'Follow your interests'}</span><h2>{nl?'Waar begint jouw vraag?':'Where does your curiosity lead?'}</h2></div><nav class="topic-index" aria-label={nl?'Onderwerpen':'Browse topics'}>{topics.map(topic=><a href={url(prefix+`articles/?topic=${topic.id}`)}><span class="topic-link-content"><span class="topic-icon" aria-hidden="true">
{topic.id==='grids'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M13.5 2.5 5 13h5l-.5 8.5L19 10h-5l-.5-7.5Z"/></svg>}
{topic.id==='renewables'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M20 4C11 4 5 7 5 13a6 6 0 0 0 6 6c6 0 9-6 9-15Z"/><path d="M4 21c3-5 7-8 12-11"/></svg>}
{topic.id==='nuclear'&&<svg viewBox="0 0 24 24" focusable="false"><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(30 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(-30 12 12)"/><circle cx="12" cy="12" r="1"/></svg>}
{topic.id==='storage'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M5 16h14l1-5-2-2-1.5-4h-9L6 9l-2 2 1 5Z"/><path d="M10 10h4m-3 2-1 2h3l-1 2"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/></svg>}
{topic.id==='markets'&&<svg viewBox="0 0 24 24" focusable="false"><path d="M4 20V5m0 15h17M7 15l4-4 3 2 6-7"/><path d="M16 6h4v4"/></svg>}
{topic.id==='climate'&&<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>}
</span><span>{topic[locale]}</span></span><span class="topic-count">{site.articles.filter(a=>topicFor(a.title)===topic.id).length}</span></a>)}</nav></section>

<section class="section latest-section" aria-label={nl?'Meer artikels':'More articles'}><div class="section-heading"><div><h2 class="cursive-heading">{nl?'Energie van dichterbij':'A closer look at energy'}</h2></div><div class="latest-articles-controls">{recentPages.length>1&&<div class="slider-controls" data-slider-controls hidden><button class="slider-pause" type="button" data-slider-pause data-state="playing" aria-label={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-pause={nl?'Pauzeer automatisch doorschuiven':'Pause autoplay'} data-label-play={nl?'Hervat automatisch doorschuiven':'Resume autoplay'}><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4a.6.6 0 0 0 .9.5l9.8-6.2a.6.6 0 0 0 0-1L9.4 5.3a.6.6 0 0 0-.9.5Z"/></svg></button><div class="slider-segments" data-slider-segments role="group" aria-label={nl?'Kies wat je ziet':'Choose what to show'} data-label-page={nl?'Ga naar pagina {n}':'Go to page {n}'} data-label-card={nl?'Ga naar kaart {n}':'Go to card {n}'}></div></div>}<a class="text-link" href={url(prefix+'articles/')}>{nl?'Alle artikels':'All articles'}</a></div></div><div class="latest-article-pages">{recentPages.length>1&&<><button class="slider-arrow slider-arrow--prev is-hidden" type="button" data-slider-prev aria-label={nl?'Vorige artikels':'Previous articles'} tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><button class="slider-arrow slider-arrow--next" type="button" data-slider-next aria-label={nl?'Volgende artikels':'Next articles'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></>}{recentPages.map((page,index)=><div class="article-grid" data-article-page={index} aria-hidden={index!==0} hidden={index!==0}>{page.map(article=><ArticleCard article={article} locale={locale} showSubtitle={!homepageDescriptionlessSlugs.has(article.slug)} sizes={imageSizes.carouselCard}/>)}</div>)}</div></section>

</div>
<section class="community-band" id="about"><div class="container community-grid"><div><span class="eyebrow">Young Energy Reviewers Association</span><h2>{nl?'Jonge denkers \nGrote vraagstukken':'Young minds \nBig energy questions'}</h2><div class="community-portraits">{faces.map(member=><div class:list={['community-portrait',{'community-portrait--close':member!.portraitCrop==='close'}]}><img {...faceImages.get(member)} alt={member!.name} loading="lazy" decoding="async"/></div>)}</div><a class="light-link" href={url(prefix+'about/')}>{nl?'Ontmoet YERA':'Meet YERA'}</a></div><div><p set:html={copy.about.text}/><div class="community-note" id="board"><span>{current?.title}</span><a href={url(prefix+'about/#board')}>{copy.about.boardOf}</a></div></div></div></section>

<section class="contribute-section container" id="contact"><span class="eyebrow">{nl?'Jouw perspectief telt':'Bring your perspective'}</span><div><h2>{nl?'Een vraag, een idee, \nEen andere kijk?':'A question, an idea,\nA different view?'}</h2><div><p>{nl?'Schrijf mee, stel je vragen of help ons mensen samen te brengen.':'Write with us, ask a question, or help bring people together.'}</p><a class={buttonVariants({size:'lg'})} href={url(prefix+'contact/')}>{nl?'Neem contact op':'Get in touch'}</a></div></div></section>

<script>
 type SliderDirection='next'|'previous';
 const prepareSliderPage=(page:HTMLElement,direction:SliderDirection)=>{
  page.hidden=false;
  page.setAttribute('aria-hidden','false');
  page.classList.remove('slider-page-active','slider-page-leaving','slider-page-enter-next','slider-page-enter-previous');
  page.classList.add(direction==='next'?'slider-page-enter-next':'slider-page-enter-previous');
  const cards=page.querySelectorAll<HTMLElement>('.article-card, .social-post-card');
  cards.forEach((item,index)=>{
   item.classList.remove('slider-card-enter','slider-card-leave');
   item.classList.add('is-revealed');
   item.style.setProperty('--reveal-delay',`${index*60}ms`);
  });
  void page.offsetWidth;
  requestAnimationFrame(()=>{
   page.classList.add('slider-page-active');
   cards.forEach(item=>{
    void item.offsetWidth;
    item.classList.add('slider-card-enter');
   });
  });
 };
 // <=760px: CSS shows every card as one horizontal swipe strip; wider screens show pages of three.
 const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
 const setupSlider=(sectionSelector:string,pageSelector:string,storageKey:string)=>{
  const section=document.querySelector<HTMLElement>(sectionSelector);
  const pages=section?.querySelectorAll<HTMLElement>(pageSelector);
  if(!section||!pages?.length||pages.length<2)return;
  const pageContainer=pages[0].parentElement;
  if(!pageContainer)return;
  const controls=section.querySelector<HTMLElement>('[data-slider-controls]');
  const pauseButton=section.querySelector<HTMLButtonElement>('[data-slider-pause]');
  const segmentList=section.querySelector<HTMLElement>('[data-slider-segments]');
  const mobileQuery=window.matchMedia('(max-width: 760px)');
  const stripCards=Array.from(pageContainer.querySelectorAll<HTMLElement>('.article-card, .social-post-card'));
  let currentPage=0;
  let currentCard=0;
  let segments:HTMLButtonElement[]=[];
  // Pause reasons. Only the button's pause is sticky; the others end on their own.
  let hoverPaused=false;
  let focusPaused=false;
  let touchPaused=false;
  const storedPause=()=>{try{return sessionStorage.getItem(storageKey)==='paused';}catch{return false;}};
  const storePause=(value:boolean)=>{try{if(value)sessionStorage.setItem(storageKey,'paused');else sessionStorage.removeItem(storageKey);}catch{}};
  // Visitors who prefer reduced motion start paused; anyone who paused earlier this visit stays paused.
  let userPaused=reducedMotion.matches||storedPause();

  const syncPageHeight=()=>{
   pageContainer.style.removeProperty('--slider-page-height');
   if(mobileQuery.matches)return;
   const hiddenStates=Array.from(pages,page=>page.hidden);
   pages.forEach(page=>{
    page.hidden=false;
    page.style.visibility='hidden';
   });
   const height=Math.max(...Array.from(pages,page=>page.offsetHeight));
   pages.forEach((page,index)=>{
    page.hidden=hiddenStates[index];
    page.style.removeProperty('visibility');
   });
   pageContainer.style.setProperty('--slider-page-height',`${height}px`);
   placeArrows();
  };
  pages.forEach(page=>page.querySelectorAll('img').forEach(image=>image.addEventListener('load',syncPageHeight,{once:true})));
  window.addEventListener('resize',syncPageHeight);
  document.fonts?.ready.then(syncPageHeight);

  const showPage=(pageIndex:number,direction:SliderDirection)=>{
   const previousPage=pages[currentPage];
   currentPage=(pageIndex+pages.length)%pages.length;
   const nextPage=pages[currentPage];
   if(previousPage===nextPage)return;
   previousPage.classList.remove('slider-page-leave-next','slider-page-leave-previous');
   previousPage.classList.add(direction==='next'?'slider-page-leave-next':'slider-page-leave-previous');
   const previousCards=previousPage.querySelectorAll<HTMLElement>('.article-card, .social-post-card');
   previousCards.forEach(item=>item.classList.remove('slider-card-enter','slider-card-leave'));
   void previousPage.offsetWidth;
   // One motion: outgoing cards fade out together, then the incoming cards slide in staggered (CSS).
   previousCards.forEach(item=>item.classList.add('slider-card-leave'));
   prepareSliderPage(nextPage,direction);
   // Hide the old page once its cards have faded (matches the .2s slider-card-leave animation),
   // unless rapid clicking has made it the current page again.
   window.setTimeout(()=>{
    if(previousPage===pages[currentPage]||mobileQuery.matches)return;
    previousPage.hidden=true;
    previousPage.classList.remove('slider-page-leaving','slider-page-leave-next','slider-page-leave-previous');
    previousCards.forEach(item=>item.classList.remove('slider-card-leave'));
    previousPage.setAttribute('aria-hidden','true');
   },220);
   requestAnimationFrame(()=>{
    previousPage.classList.remove('slider-page-active');
    previousPage.classList.add('slider-page-leaving');
    nextPage.setAttribute('aria-hidden','false');
   });
  };

  // Progress: the active segment's fill animation is the autoplay timer. When it finishes the slider
  // advances, and pausing simply freezes it, so the bar and the timer can never disagree.
  const itemCount=()=>mobileQuery.matches?stripCards.length:pages.length;
  const activeIndex=()=>mobileQuery.matches?currentCard:currentPage;
  const updatePauseState=()=>{
   section.classList.toggle('slider-paused',userPaused||hoverPaused||focusPaused||touchPaused||document.hidden);
   if(pauseButton){
    pauseButton.dataset.state=userPaused?'paused':'playing';
    pauseButton.setAttribute('aria-label',(userPaused?pauseButton.dataset.labelPlay:pauseButton.dataset.labelPause)||'');
   }
  };
  // Desktop side arrows: each is shown only when it leads somewhere (no wrapping), so they never do the same thing.
  const prevArrow=pageContainer.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const nextArrow=pageContainer.querySelector<HTMLButtonElement>('[data-slider-next]');
  const updateArrows=()=>{
   const focused=document.activeElement;
   const states:[HTMLButtonElement|null,boolean][]=[[prevArrow,currentPage>0],[nextArrow,currentPage<pages.length-1]];
   for(const [arrow,usable] of states){
    if(!arrow)continue;
    arrow.classList.toggle('is-hidden',!usable);
    arrow.tabIndex=usable?0:-1;
   }
   // Don't strand keyboard focus on an arrow that just disappeared (move it once the other one is visible).
   // Mouse clicks also focus buttons, but moving focus then would only show a stray focus ring.
   const stranded=states.find(([arrow,usable])=>arrow&&arrow===focused&&!usable&&arrow.matches(':focus-visible'));
   if(stranded)states.find(([arrow,usable])=>arrow&&usable)?.[0]?.focus();
  };
  // Centre the arrows on the card images (offsetTop ignores the cards' slide-in transforms).
  const placeArrows=()=>{
   if(mobileQuery.matches)return;
   const image=pages[currentPage]?.querySelector<HTMLImageElement>('img');
   if(!image?.offsetHeight)return;
   let top=image.offsetHeight/2;
   for(let node:HTMLElement|null=image;node&&node!==pageContainer;node=node.offsetParent as HTMLElement|null)top+=node.offsetTop;
   pageContainer.style.setProperty('--slider-arrow-top',`${Math.round(top)}px`);
  };
  const restartProgress=()=>{
   updateArrows();
   placeArrows();
   const active=activeIndex();
   segments.forEach((segment,index)=>{
    segment.classList.remove('is-running');
    segment.classList.toggle('is-active',index===active);
    if(index===active)segment.setAttribute('aria-current','true');else segment.removeAttribute('aria-current');
   });
   const segment=segments[active];
   if(!segment)return;
   void segment.offsetWidth;
   segment.classList.add('is-running');
  };
  const centreCard=(card:HTMLElement)=>{
   const stripRect=pageContainer.getBoundingClientRect();
   const cardRect=card.getBoundingClientRect();
   pageContainer.scrollTo({left:pageContainer.scrollLeft+(cardRect.left+cardRect.width/2)-(stripRect.left+stripRect.width/2),behavior:'smooth'});
  };
  const goTo=(index:number)=>{
   if(mobileQuery.matches){
    // Scrolling updates the current card (and restarts the progress) via updateFocus.
    const card=stripCards[(index+stripCards.length)%stripCards.length];
    if(card)centreCard(card);
    return;
   }
   if(index!==currentPage)showPage(index,index>currentPage?'next':'previous');
   restartProgress();
  };
  const advance=()=>goTo((activeIndex()+1)%itemCount());
  prevArrow?.addEventListener('click',()=>{if(currentPage>0)goTo(currentPage-1);});
  nextArrow?.addEventListener('click',()=>{if(currentPage<pages.length-1)goTo(currentPage+1);});
  const buildSegments=()=>{
   if(!segmentList)return;
   const template=(mobileQuery.matches?segmentList.dataset.labelCard:segmentList.dataset.labelPage)||'{n}';
   segments=Array.from({length:itemCount()},(_,index)=>{
    const segment=document.createElement('button');
    segment.type='button';
    segment.className='slider-segment';
    segment.setAttribute('aria-label',template.replace('{n}',String(index+1)));
    const fill=document.createElement('span');
    fill.className='slider-segment-fill';
    fill.addEventListener('animationend',()=>{if(segment.classList.contains('is-running'))advance();});
    segment.append(fill);
    segment.addEventListener('click',()=>goTo(index));
    return segment;
   });
   segmentList.replaceChildren(...segments);
   restartProgress();
  };

  pauseButton?.addEventListener('click',()=>{
   userPaused=!userPaused;
   storePause(userPaused);
   updatePauseState();
  });
  // Hover pauses over the cards only (real mice; taps fire a pointerenter with no matching leave),
  // so the bar keeps running while someone uses the controls.
  pageContainer.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse'){hoverPaused=true;updatePauseState();}});
  pageContainer.addEventListener('pointerleave',event=>{if(event.pointerType==='mouse'){hoverPaused=false;updatePauseState();}});
  // Keyboard focus on a card pauses; focus from a tap or click (no focus ring), or on the controls, does not.
  section.addEventListener('focusin',event=>{
   const target=event.target as HTMLElement;
   focusPaused=!controls?.contains(target)&&target.matches(':focus-visible');
   updatePauseState();
  });
  section.addEventListener('focusout',event=>{
   if(!section.contains(event.relatedTarget as Node|null)){focusPaused=false;updatePauseState();}
  });
  // Touch: hold still while the finger is down, then continue where the bar was (like hover on desktop).
  // A swipe that lands on another card still starts that card's own bar, via updateFocus.
  pageContainer.addEventListener('touchstart',()=>{touchPaused=true;updatePauseState();},{passive:true});
  const resumeAfterTouch=()=>{touchPaused=false;updatePauseState();};
  pageContainer.addEventListener('touchend',resumeAfterTouch,{passive:true});
  pageContainer.addEventListener('touchcancel',resumeAfterTouch,{passive:true});
  document.addEventListener('visibilitychange',updatePauseState);
  reducedMotion.addEventListener('change',()=>{if(reducedMotion.matches){userPaused=true;updatePauseState();}});

  // Mobile strip: the card snapped to the centre is "current"; CSS dims and shrinks the others.
  const updateFocus=()=>{
   if(!mobileQuery.matches)return;
   const stripRect=pageContainer.getBoundingClientRect();
   const stripCentre=stripRect.left+stripRect.width/2;
   // Compare centres: the scale transform keeps a card's centre where its layout box is.
   const distance=(card:HTMLElement)=>{const rect=card.getBoundingClientRect();return Math.abs(rect.left+rect.width/2-stripCentre);};
   const current=stripCards.reduce((best,card)=>distance(card)<distance(best)?card:best,stripCards[0]);
   stripCards.forEach(card=>card.classList.toggle('is-current',card===current));
   const index=stripCards.indexOf(current);
   if(index!==currentCard){currentCard=index;restartProgress();}
  };
  let focusFrame=0;
  pageContainer.addEventListener('scroll',()=>{
   cancelAnimationFrame(focusFrame);
   focusFrame=requestAnimationFrame(updateFocus);
  },{passive:true});

  // The controls live in the section header on desktop and move below the strip on mobile.
  const controlsHome=controls?.parentElement;
  const controlsNext=controls?.nextSibling??null;
  const placeControls=(mobile:boolean)=>{
   if(!controls||!controlsHome)return;
   if(mobile){if(controls.previousElementSibling!==pageContainer)pageContainer.after(controls);}
   else if(controls.parentElement!==controlsHome)controlsHome.insertBefore(controls,controlsNext);
   controls.classList.toggle('slider-controls--below',mobile);
  };
  // Mobile: expose every card (the strip scrolls). Desktop: show only the current page.
  const applyLayout=()=>{
   const mobile=mobileQuery.matches;
   placeControls(mobile);
   if(mobile)pageContainer.dataset.focus='';
   else{delete pageContainer.dataset.focus;stripCards.forEach(card=>card.classList.remove('is-current'));}
   pages.forEach((page,index)=>{
    const visible=mobile||index===currentPage;
    page.hidden=!visible;
    page.setAttribute('aria-hidden',String(!visible));
    page.classList.remove('slider-page-leaving','slider-page-leave-next','slider-page-leave-previous','slider-page-enter-next','slider-page-enter-previous');
    page.classList.toggle('slider-page-active',!mobile&&index===currentPage);
   });
   syncPageHeight();
   updateFocus();
   buildSegments();
   updatePauseState();
  };
  mobileQuery.addEventListener('change',applyLayout);
  applyLayout();
  if(controls)controls.hidden=false;
 };
