---
import {url} from '@/lib/utils';import {localHtml} from '@/lib/content';import {prepareArticle,sourceMarkup} from '@/lib/editorial';import {topicLabel,topicFor,formatDate} from '@/lib/topics';import type {Article} from '@/data/articles';import site from '@/data/site.json';import ArticleCard from './ArticleCard.astro';
interface Props{article:Article;}
const {article}=Astro.props;const prepared=prepareArticle(article.content);
const seen=new Set([article.title.toLowerCase()]);const related=site.articles.filter(a=>{if(topicFor(a.title)!==topicFor(article.title)||seen.has(a.title.toLowerCase()))return false;seen.add(a.title.toLowerCase());return true;}).slice(0,3);
---
<header class="page-intro article-intro"><div class="container"><div class="article-breadcrumb"><a href={url('articles/')}>Journal</a><span>/</span><a href={url(`articles/?topic=${topicFor(article.title)}`)}>{topicLabel(article.title)}</a></div><h1>{article.title}</h1>{article.subtitle&&<p class="article-deck">{article.subtitle}</p>}<div class="reading-meta"><span>By <strong>{article.author||'YERA'}</strong></span><time datetime={article.date}>{formatDate(article.date)}</time><span>{prepared.minutes} min read</span><span class="original-category">{article.category}</span></div></div></header>
<div class="container reading-layout"><aside class="reading-sidebar"><div class="reading-sticky"><a class="back-link" href={url('articles/')}>All articles</a>{prepared.contents.length>1&&<nav aria-label="In this article"><span class="eyebrow">In this article</span><ol>{prepared.contents.map(item=><li><a href={`#${item.id}`}>{item.label}</a></li>)}{article.sources&&<li><a href="#references">Sources</a></li>}</ol></nav>}<div class="sidebar-note">YERA<br/><span>Young Energy Reviewers Association</span></div></div></aside><article class="prose original-content"><div set:html={localHtml(prepared.html)}/>{article.sources&&<section class="sources" id="references"><span class="eyebrow">Further reading</span><h2>Sources / Bronnen</h2><div class="source-text" set:html={localHtml(sourceMarkup(article.sources))}/></section>}</article></div>
{related.length>0&&<section class="section container related-section"><div class="section-heading"><div><span class="eyebrow">Keep exploring</span><h2>Another perspective.</h2></div><a class="text-link" href={url(`articles/?topic=${topicFor(article.title)}`)}>{topicLabel(article.title)}</a></div><div class="article-grid">{related.map(item=><ArticleCard article={item}/>)}</div></section>}
