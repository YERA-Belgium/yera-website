---
import site from '@/data/site.json';import MemberGrid from './MemberGrid.astro';import {responsiveImage} from '@/lib/images';
interface Props{kind:'board'|'alumni';locale?:'en'|'nl';}
const {kind,locale='en'}=Astro.props;const copy=site.messages[locale];
const title=kind==='board'?copy.navigation.formerBoards:copy.alumni.title;
---
<section class="page-intro"><div class="container"><span class="eyebrow">YERA</span><h1>{title}</h1>{kind==='alumni'&&<p>{copy.alumni.subtitle}</p>}</div></section>
<section class="section container">{kind==='board'?site.boards.filter(b=>!b.current).map(board=>{const image=board.image&&responsiveImage(board.image,800);return <section class="board-year"><h2>{board.title}</h2>{image&&<img class="board-photo" src={image.src} srcset={image.srcset} sizes={image.sizes} alt={`YERA ${board.title}`} width={image.width} height={image.height} loading="lazy" decoding="async"/>}<MemberGrid memberIds={board.memberIds} compact/></section>}):<div class="member-grid">{site.alumni.map(person=><article class="member-card"><h3>{person.name}</h3>{person.linkedin&&<a class="text-link" href={person.linkedin}>LinkedIn</a>}</article>)}</div>}
{kind==='alumni'&&<div class="prose" style="margin-top:60px"><h2>{copy.alumni.becomeAlumni}</h2><p set:html={copy.alumni.howToSupport}/></div>}</section>
