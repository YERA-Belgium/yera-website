---
import site from '@/data/site.json';
import Layout from '@/layouts/Layout.astro';
import {url} from '@/lib/utils';
import {localHtml} from '@/lib/content';
import {isPastEvent} from '@/lib/events';
import {responsiveImage} from '@/lib/images';
export function getStaticPaths(){return site.events.map(event=>({params:{slug:event.slug},props:{event}}));}
const {event}=Astro.props;
const image2='image2' in event?event.image2:'';
const [, , year]=event.date.split('/');
const past=!!year&&isPastEvent(event.date);
const eventImage=event.image&&responsiveImage(event.image,800);
const secondaryImage=image2&&responsiveImage(image2,800);
---
<Layout title={event.title}><section class="page-intro"><div class="container"><a class="eyebrow" href={url('events/')}>YERA / Events</a><h1>{event.title}</h1>{event.subtitle&&<p>{event.subtitle}</p>}</div></section><section class="section container article-layout"><aside class="article-sidebar"><dl><dt>Date</dt><dd>{event.date}</dd><dt>From / Until</dt><dd>{event.start} – {event.end}</dd><dt>Location</dt><dd>{event.location}</dd></dl></aside><article class="prose original-content">{past&&<p class="badge">Past event · Registration closed</p>}{eventImage&&<figure class="event-gallery"><img class="event-cover" src={eventImage.src} srcset={eventImage.srcset} sizes={eventImage.sizes} alt={event.title} width={eventImage.width} height={eventImage.height} fetchpriority="high"/>{secondaryImage&&<img class="event-cover" src={secondaryImage.src} srcset={secondaryImage.srcset} sizes={secondaryImage.sizes} alt={`${event.title} schedule`} width={secondaryImage.width} height={secondaryImage.height} loading="lazy" decoding="async"/>}</figure>}<div set:html={localHtml(event.content)}/>{!event.content.replace(/<[^>]*>/g,'').trim()&&<p class="source-text">{event.extraContent}</p>}</article></section></Layout>
