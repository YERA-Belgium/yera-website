---
import site from '@/data/site.json';
import Layout from '@/layouts/Layout.astro';
import ArticleDetail from '@/components/ArticleDetail.astro';
export function getStaticPaths(){
  const main = site.articles.filter(a=>a.collection==='Main collection').map(article=>({params:{slug:article.slug},props:{article}}));
  const aliases = [
    { slug: 'smart-cities-energie-in-de-nabije-toekomst', id: 4304 },
    { slug: 'electric-vessels-the-next-tech-of-energy-storage', id: 4961 },
    { slug: 'unravelling-the-energy-crisis-key-contributors-impact-and-mitigation-strategies', id: 4828 },
    { slug: 'impact-van-de-elektriciteitsproductie-op-de-volksgezondheid-2', id: 4297 },
  ];
  const aliasRoutes = aliases.map(({slug, id}) => {
    const article = site.articles.find(a => a.id === id)!;
    return { params: { slug }, props: { article } };
  });
  return [...main, ...aliasRoutes];
}
const {article}=Astro.props;
---
<Layout title={article.title} description={article.description}><ArticleDetail article={article}/></Layout>
