---
import Layout from '@/layouts/Layout.astro';import Directory from '@/components/Directory.astro';
export function getStaticPaths(){return ['board','alumni'].map(kind=>({params:{directory:kind},props:{kind:kind as 'board'|'alumni'}}));}
const {kind}=Astro.props;
---
<Layout title={kind==='board'?'Former boards':'Honorary members'}><Directory kind={kind}/></Layout>
